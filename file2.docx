from collections import deque
def is_valid(missionaries_left,cannibals_left):
  missionaries_right = 3 - missionaries_left
  cannibals_right = 3 - cannibals_left
  if missionaries_left < 0 or cannibals_left < 0:
    return False
  if missionaries_left > 0 and cannibals_left > missionaries_left:
    return False
  if missionaries_right > 0 and cannibals_right > missionaries_right:
    return False
  return True
